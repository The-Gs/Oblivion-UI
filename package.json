{
  "name": "oblivion-ui",
  "version": "0.3.0",
  "description": "Liquid glass React components \u2014 frosted surfaces, oxblood accents, no gradients.",
  "license": "Apache-2.0",
  "author": "The G's",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "TRADEMARK.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "glassmorphism",
    "dark-theme",
    "design-system"
  ]
}
